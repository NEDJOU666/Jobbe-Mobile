generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  EMPLOYER
  ADMIN
  SUPERADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum LocationType {
  REMOTE
  ONSITE
  HYBRID
}

enum PostStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplyType {
  INTERNAL
  EXTERNAL
}

enum PostType {
  JOB
  INTERNSHIP
}

enum FirmStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MembershipRole {
  COMPANY_OWNER
  ADMIN
  RECRUITER
  VIEWER
}

enum ApplicationStatus {
  PENDING_REVIEW
  FORWARDED_TO_FIRM
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFER
  REJECTED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  FIRM_VERIFIED
  FIRM_REJECTED
  CREDIT_PURCHASED
  INVITATION_RECEIVED
  INVITATION_RESPONSE
  GENERAL
}

enum CreditTransactionType {
  PURCHASE
  SPEND
  REFUND
  BONUS
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String?
  role            UserRole  @default(USER)
  isBlocked       Boolean   @default(false)
  isEmailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  newsletter      Boolean   @default(false)
  avatar          String?
  googleId        String?   @unique
  githubId        String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  otpCodes       OtpCode[]
  passwordResets PasswordReset[]
  memberships    MemberShip[]
  profile        UserProfile?
  documents      UserDocument[]
  applications   Application[]
  savedPosts     SavedPost[]
  notifications  Notification[]
  credit         UserCredit?
  creditTxns     CreditTransaction[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpCode {
  id        String    @id @default(cuid())
  codeHash  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  codeHash  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Firms ────────────────────────────────────────────────────────────────────

model Firms {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  logo        String?
  description String?
  website     String?
  country     String
  address     String?
  city        String
  domain_role String
  size        String?
  status      FirmStatus @default(PENDING)
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  memberships  MemberShip[]
  posts        Post[]
  applications Application[]

  @@index([isDeleted])
}

model MemberShip {
  id        String         @id @default(cuid())
  user_id   String
  firm_id   String
  role      MembershipRole @default(COMPANY_OWNER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  firms Firms @relation(fields: [firm_id], references: [id], onDelete: Cascade)

  @@unique([user_id, firm_id])
  @@index([firm_id])
}

// ─── Posts ────────────────────────────────────────────────────────────────────

model Post {
  id                  String         @id @default(cuid())
  title               String
  description         String
  postType            PostType
  company_id          String
  createdBy           String
  employmentType      EmploymentType
  locationType        LocationType
  location            String
  isPaid              Boolean        @default(false)
  creditCost          Int            @default(0)
  applicationDeadline DateTime?
  applyType           ApplyType      @default(INTERNAL)
  applyUrl            String?
  status              PostStatus     @default(DRAFT)
  viewCount           Int            @default(0)
  properties          Json
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  firm         Firms         @relation(fields: [company_id], references: [id])
  applications Application[]
  savedBy      SavedPost[]
}

// ─── User Profile ─────────────────────────────────────────────────────────────

model UserProfile {
  id             String   @id @default(cuid())
  user_id        String   @unique
  headline       String?
  bio            String?
  location       String?
  phone          String?
  website        String?
  linkedin       String?
  github         String?
  skills         String[]
  languages      String[] // "lang:level" e.g. "French:Native"
  experience     Json?    // [{role, firm, from, to, current}]
  education      Json?    // [{degree, school, year}]
  openToWork     Boolean  @default(true)
  profileVisible Boolean  @default(true)
  showSalary     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model UserDocument {
  id           String   @id @default(cuid())
  user_id      String
  name         String
  url          String?
  documentType String   @default("RESUME")
  size         String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ─── Applications ─────────────────────────────────────────────────────────────

model Application {
  id              String              @id @default(cuid())
  post_id         String
  user_id         String
  firm_id         String
  coverLetter     String?
  documents       Json?
  status          ApplicationStatus[] @default([PENDING_REVIEW])
  statusUpdatedAt DateTime            @default(now())
  creditSpent     Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  post Post  @relation(fields: [post_id], references: [id])
  user User  @relation(fields: [user_id], references: [id])
  firm Firms @relation(fields: [firm_id], references: [id])

  @@unique([post_id, user_id])
  @@index([user_id])
  @@index([firm_id])
}

// ─── Saved Posts ──────────────────────────────────────────────────────────────

model SavedPost {
  id        String   @id @default(cuid())
  post_id   String
  user_id   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([user_id])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  user_id   String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, isRead])
}

// ─── Credits ──────────────────────────────────────────────────────────────────

model UserCredit {
  id        String   @id @default(cuid())
  user_id   String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id          String                @id @default(cuid())
  user_id     String
  amount      Int
  type        CreditTransactionType
  referenceId String?
  description String?
  createdAt   DateTime              @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}
