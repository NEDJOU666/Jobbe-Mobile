# Copy this file to .env and fill in all values before starting the app.
# NEVER commit .env to version control.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jobfinder?schema=public"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ── LinkedIn OAuth ─────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_CALLBACK_URL=http://localhost:3001/api/auth/linkedin/callback

# ── Frontend / API ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://api.jobfinder.oxbiy.com/api
EXPO_PUBLIC_UPLOADTHING_URL=https://jobfinder.oxbiy.com
FRONTEND_URL=http://localhost:3000

# ── Resend (email) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM="JobFinder <noreply@yourdomain.com>"
RESEND_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Fapshi (payment) ───────────────────────────────────────────────────────────
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_BASE_URL=https://sandbox.fapshi.com
# Secret that must match the ?secret= query param in your Fapshi dashboard webhook URL
FAPSHI_WEBHOOK_SECRET=REPLACE_ME
